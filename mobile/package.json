{
  "name": "DeepTutorRNOH",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "android": "pnpm run rich:assets && react-native run-android",
    "android:test-apk": "pnpm run build:app",
    "build:app": "pnpm run rich:assets && node scripts/build-android-test.mjs",
    "harmony": "pnpm run rich:assets && react-native run-harmony",
    "ios": "pnpm run rich:assets && react-native run-ios",
    "bundle:android": "pnpm run rich:assets && react-native bundle --platform android --dev false --entry-file index.js --bundle-output dist/android/index.bundle --assets-dest dist/android",
    "bundle:harmony": "pnpm run rich:assets && react-native bundle-harmony --dev false",
    "typecheck": "pnpm run rich:assets && tsc --noEmit",
    "lint": "eslint .",
    "start": "pnpm run rich:assets && react-native start",
    "test": "jest --runInBand",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run bundle:android && pnpm run bundle:harmony",
    "rich:assets": "node scripts/build-rich-assets.mjs"
  },
